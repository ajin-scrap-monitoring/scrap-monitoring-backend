# Rendered by the Nginx image entrypoint. Never publish the rendered token.
upstream monitoring_backend {
    server backend:8000;
}

upstream camera_media {
    server ${MEDIA_PROXY_UPSTREAM};
}

server {
    listen 8080;
    server_tokens off;

    # Edge v2 point-array limits are finalized after payload size measurements.
    # Keep this receiver separate from the ordinary dashboard JSON locations.
    location /api/edge/v2/ {
        client_max_body_size 0;
        proxy_pass http://monitoring_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Same-origin dashboard login and JSON APIs share the session cookie.
    location /api/ {
        proxy_pass http://monitoring_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /_media_auth {
        internal;
        proxy_pass http://monitoring_backend/api/v1/media/access;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization "";
    }

    # Only read access to these two media resources is exposed to browsers.
    location ~ "^/media/(cameras/[A-Za-z0-9][A-Za-z0-9._~-]*/live|clips/[0-9a-fA-F-]{36}/content)$" {
        if ($request_method != GET) { return 405; }
        auth_request /_media_auth;
        rewrite ^/media/(.*)$ /api/v1/$1 break;
        proxy_pass http://camera_media;
        proxy_set_header Authorization "Bearer ${MEDIA_API_TOKEN}";
        proxy_set_header Cookie "";
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_hide_header Set-Cookie;
        proxy_hide_header X-Powered-By;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 10s;
        proxy_redirect off;
        add_header Cache-Control "no-store" always;
        add_header X-Accel-Buffering "no" always;
    }

    # HLS manifests contain absolute /api/v2 segment URIs. Rewrite them to the
    # same authenticated gateway prefix; FastAPI never receives video bytes.
    location ~ "^/media/daily-recordings/[0-9a-fA-F-]{36}/(hls/index\.m3u8|media/[A-Za-z0-9][A-Za-z0-9._~-]{0,127}\.ts|content)$" {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        auth_request /_media_auth;
        rewrite ^/media/(.*)$ /api/v2/$1 break;
        proxy_pass http://camera_media;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_set_header Accept-Encoding "";
        proxy_hide_header Set-Cookie;
        proxy_hide_header X-Powered-By;
        proxy_hide_header Cache-Control;
        sub_filter_types application/vnd.apple.mpegurl;
        sub_filter_once off;
        sub_filter '/api/v2/daily-recordings/' '/media/daily-recordings/';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 30s;
        proxy_redirect off;
        add_header Cache-Control "no-store" always;
        add_header X-Accel-Buffering "no" always;
    }

    # FastAPI validates the session, camera and selected resource, then hands off
    # a fixed internal path. Statuses such as 404/410 are preserved before bytes flow.
    location ~ "^/media/(clips|daily-recordings)/[0-9a-f-]{36}/thumbnail$" {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        proxy_pass http://monitoring_backend;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization "";
        proxy_hide_header Cache-Control;
        proxy_hide_header X-Content-Type-Options;
        proxy_cache off;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Only an authorized X-Accel-Redirect can enter this image-only location.
    location ~ "^/_thumbnail/(v1/clips|v2/daily-recordings)/[0-9a-f-]{36}/thumbnail$" {
        internal;
        rewrite ^/_thumbnail/(.*)$ /api/$1 break;
        proxy_pass http://camera_media;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header Range "";
        proxy_set_header If-Range "";
        proxy_set_header If-None-Match "";
        proxy_set_header If-Modified-Since "";
        proxy_hide_header Set-Cookie;
        proxy_hide_header X-Accel-Redirect;
        proxy_ignore_headers X-Accel-Redirect;
        proxy_hide_header Cache-Control;
        proxy_hide_header X-Content-Type-Options;
        proxy_buffering off;
        proxy_cache off;
        proxy_redirect off;
        proxy_intercept_errors on;
        error_page 301 302 303 307 308 =502 @thumbnail_bad_response;
        proxy_read_timeout 10s;
        # Nginx preserves Cache-Control from the authorized X-Accel handoff.
        add_header X-Content-Type-Options "nosniff" always;
    }

    location @thumbnail_bad_response {
        add_header X-Content-Type-Options "nosniff" always;
        return 502;
    }

    location / { return 404; }
}

# ==============================================================================
# Ajin Scrap Monitoring Backend Environment Variables Template
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# Server Basic Settings
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# CORS Allowed Origins (Comma-separated, or * for all)
CORS_ORIGINS=http://localhost:3000,http://scrap-server-01.tail2e96c5.ts.net

# Database URL
# For Docker deployment with volume mount (./data:/app/data):
DATABASE_URL=sqlite+aiosqlite:////app/data/scrap_monitoring.db
# For local machine execution outside Docker:
# DATABASE_URL=sqlite+aiosqlite:///./test_scrap_monitoring.db

# Edge Device Shared Secret Authentication Key
EDGE_API_KEY=dev-edge-secret-key-12345

# Edge v2 credentials: private JSON list; empty disables v2 device authentication.
# Each entry requires site_id, edge_id, sensor_ids (two distinct IDs), and token.
# Generate a separate random token per device; never reuse EDGE_API_KEY.
EDGE_V2_DEVICES=[]

# Scrap Pit Warning & Critical Collection Thresholds (%)
DEFAULT_WARNING_THRESHOLD=75.0
DEFAULT_CRITICAL_THRESHOLD=85.0
ALERT_COOLDOWN_SECONDS=1800

# Camera & WebRTC WHEP Media Streaming Settings
# Upstream Media Server WHEP Base URL (e.g. http://scrap-server-01.tail2e96c5.ts.net:8889)
MEDIA_SERVER_WHEP_URL=
# Session Time-To-Live in seconds (default 30m = 1800s)
WHEP_SESSION_TTL_SECONDS=1800
# Fallback to mock SDP answer when upstream media server is unavailable
WHEP_MOCK_FALLBACK=true

# Camera media v1 JSON control API (configure both values to enable integration)
# URL includes /api/v1; use an address reachable from the backend container.
# Example: http://media-service:8889/api/v1
MEDIA_SERVICE_URL=
MEDIA_API_TOKEN=
MEDIA_CAMERA_ID=camera-main
MEDIA_PIT_ID=pit-01
MEDIA_REQUEST_TIMEOUT_SECONDS=3
MEDIA_POLL_INTERVAL_SECONDS=2

# Optional media gateway (docker-compose.media.yml); no scheme or path here.
# Example: media-service:8889, matching MEDIA_SERVICE_URL above.
MEDIA_PROXY_UPSTREAM=
MEDIA_PROXY_PORT=8080

# External Alert Notifications (Optional SMTP)
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=

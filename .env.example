# ==============================================================================
# 아진산업 스크랩 모니터링 백엔드 환경 설정 예시 (.env.example)
# 주의: 이 파일에는 실제 비밀번호, API 키, 사설 네트워크 주소를 작성하지 않습니다.
# ==============================================================================

# 서버 기본 설정
APP_ENV=development
APP_NAME=scrap-monitoring-backend
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# CORS 허용 도메인 (쉼표로 구분)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 데이터베이스 접속 URL (비동기 드라이버 사용)
# 개발/테스트용 SQLite 기본값: sqlite+aiosqlite:///./test_scrap_monitoring.db
# 운영 PostgreSQL 예시: postgresql+asyncpg://<USER>:<PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=sqlite+aiosqlite:///./test_scrap_monitoring.db

# 엣지 디바이스 인증 토큰/API 키 (센서 데이터 인입 시 검증)
EDGE_API_KEY=dev-edge-secret-key-12345

# 수거 및 경고 기본 임계치 설정 (%)
DEFAULT_WARNING_THRESHOLD=75.0
DEFAULT_CRITICAL_THRESHOLD=85.0

# 알림 엔진 쿨다운 설정 (초 단위, 기본 30분 = 1800초)
ALERT_COOLDOWN_SECONDS=1800

# 외부 알림 서비스 설정 (비워둘 경우 로그 전송 모드로 동작)
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=
